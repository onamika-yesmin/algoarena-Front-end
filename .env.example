# Leave NEXT_PUBLIC_API_URL EMPTY in normal deployments.
#
# Empty means the browser calls this app's own origin (/api/...), which
# next.config.ts rewrites to the backend server-side. That keeps the session
# cookie first-party. Setting it to the backend's absolute URL makes every
# call cross-site, so the browser treats the auth cookie as third-party and
# blocks it by default — sign-in appears to work, then the next request looks
# signed out. See lib/config.ts for the full explanation.
#
# Only set it when you are deliberately pointing the browser at a backend
# that is not proxied (e.g. http://localhost:5000 during API work).
NEXT_PUBLIC_API_URL=

# Socket.IO connects directly (it is not proxied), so this one is absolute.
NEXT_PUBLIC_SOCKET_URL=https://algoarena-back-end.vercel.app

# This app's own public URL — used for canonical/Open Graph links and sitemap.
NEXT_PUBLIC_APP_URL=https://algoarena-front-end.vercel.app

# Server-side only: where next.config.ts proxies /api/* to. Override to run
# against a local backend without touching NEXT_PUBLIC_API_URL.
BACKEND_ORIGIN=https://algoarena-back-end.vercel.app
